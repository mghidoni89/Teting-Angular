# Pagina iniziale
DirectoryIndex index.php

# ---------------------------------------------------------------------------
# Server di prova: niente indicizzazione su Google.
# Vale su qualsiasi dominio diverso da infanziamontanari.it, quindi in
# produzione si spegne da sola senza toccare nulla.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <If "%{HTTP_HOST} !~ /(^|\.)infanziamontanari\.it$/i">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------------
  # Produzione: un solo indirizzo, https://www.infanziamontanari.it
  # Queste regole agiscono solo sul dominio della scuola (non sullo staging).
  # Se l'hosting non ha ancora il certificato HTTPS, commentare le 4 righe
  # che seguono finché non è attivo, altrimenti il sito non si apre.
  # -------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} (^|\.)infanziamontanari\.it$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.infanziamontanari.it%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^infanziamontanari\.it$ [NC]
  RewriteRule ^ https://www.infanziamontanari.it%{REQUEST_URI} [R=301,L]

  # -------------------------------------------------------------------------
  # Indirizzi in .html
  # Le pagine sono file .php, ma nel browser si vedono come .html:
  #   contatti.html  ->  esegue contatti.php
  #   contatti.php   ->  reindirizza (301) a contatti.html
  # Le regole funzionano in qualsiasi cartella (anche in /staging/montanari/).
  # -------------------------------------------------------------------------

  # 1) Chi apre un vecchio indirizzo .php viene mandato alla versione .html.
  #    Solo richieste GET dirette dal browser; invia.php (il modulo) resta escluso.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !/invia\.php$ [NC]
  RewriteCond %{REQUEST_URI} ^(.+)\.php$ [NC]
  RewriteRule ^[^/]+\.php$ %1.html [R=301,L]

  # 2) Un indirizzo .html esegue il file .php con lo stesso nome, se esiste
  #    e se non c'è un vero file .html con quel nome.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} ^(.+)\.html$
  RewriteCond %1.php -f
  RewriteRule ^([^/]+)\.html$ $1.php [L]

  # 3) Tutto ciò che non esiste mostra la pagina 404 del sito
  #    (anche questa funziona in qualsiasi cartella).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

# Il file di configurazione non deve essere raggiungibile dal browser
<Files "config.php">
  Require all denied
</Files>

# Niente elenco dei file nelle cartelle
Options -Indexes

# Cache per font, immagini, CSS e JS
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
